  <!--
    Fallback WDK paths. On some VS/WDK installs the WDK kernel include path is not
    injected even when PlatformToolset=WindowsKernelModeDriver10.0. build_all.bat
    discovers these paths and passes them as IT8888_WDK_* properties.
  -->
  <PropertyGroup>
    <IT8888_WDK_KM_INC Condition="'$(IT8888_WDK_KM_INC)'==''">$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\km</IT8888_WDK_KM_INC>
    <IT8888_WDK_SHARED_INC Condition="'$(IT8888_WDK_SHARED_INC)'==''">$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\shared</IT8888_WDK_SHARED_INC>
    <IT8888_WDK_UCRT_INC Condition="'$(IT8888_WDK_UCRT_INC)'==''">$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\ucrt</IT8888_WDK_UCRT_INC>
    <IT8888_WDK_KM_LIB Condition="'$(IT8888_WDK_KM_LIB)'==''">$(WindowsSdkDir)Lib\$(WindowsTargetPlatformVersion)\km\x64</IT8888_WDK_KM_LIB>
    <IT8888_WDK_WDF_INC Condition="'$(IT8888_WDK_WDF_INC)'==''">$(WindowsSdkDir)Include\wdf\kmdf\1.15</IT8888_WDK_WDF_INC>
    <IT8888_WDK_WDF_LIB Condition="'$(IT8888_WDK_WDF_LIB)'==''">$(WindowsSdkDir)Lib\wdf\kmdf\x64\1.15</IT8888_WDK_WDF_LIB>
    <IT8888_WDK_KMDF_MAJOR Condition="'$(IT8888_WDK_KMDF_MAJOR)'==''">1</IT8888_WDK_KMDF_MAJOR>
    <IT8888_WDK_KMDF_MINOR Condition="'$(IT8888_WDK_KMDF_MINOR)'==''">15</IT8888_WDK_KMDF_MINOR>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WppEnabled>false</WppEnabled>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(IT8888_WDK_WDF_INC);$(IT8888_WDK_KM_INC);$(IT8888_WDK_SHARED_INC);$(IT8888_WDK_UCRT_INC);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>KMDF_VERSION_MAJOR=$(IT8888_WDK_KMDF_MAJOR);KMDF_VERSION_MINOR=$(IT8888_WDK_KMDF_MINOR);_AMD64_;AMD64;_WIN64;WIN64;_KERNEL_MODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(IT8888_WDK_WDF_LIB);$(IT8888_WDK_KM_LIB);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>WdfDriverEntry.lib;ntoskrnl.lib;hal.lib;wmilib.lib;BufferOverflowK.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Native</SubSystem>
      <EntryPointSymbol>DriverEntry</EntryPointSymbol>
      <AdditionalOptions>/DRIVER /MANIFEST:NO %(AdditionalOptions)</AdditionalOptions>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="device.c" />
    <ClCompile Include="queue.c" />
